        "jsCode": "const items = $input.all();\nconst products = items.map(item => item.json);\n\n// Build a formatted list\nlet productList = \"Here is our current inventory:\\n\\n\";\n\nproducts.forEach((product, index) => {\n  productList += `${index + 1}. ${product.name}\\n`;\n  productList += `   Price: $${product.price}\\n`;\n  productList += `   Stock: ${product.stock} units\\n`;\n  productList += `   ${product.description}\\n\\n`;\n});\n\n// Return as a single item\nreturn [{\n  json: {\n    product_list: productList,\n    total_products: products.length,\n  }\n}];"
