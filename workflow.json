      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  // Combine description and tags into one searchable text\n  const description = item.json.description || \"\";\n  const tags = item.json.tags || \"\";\n  const name = item.json.name || \"\";\n  \n  // Create a rich text field for embedding\n  const textToEmbed = `${name}. ${description}. Tags: ${tags}`;\n  \n  // Return the data with the new field\n  return {\n    json: {\n      // Keep all original fields\n      ...item.json,\n      // Add the combined text field for embedding\n      textToEmbed: textToEmbed,\n      // Ensure metadata fields are clean\n      price: Number(item.json.price) || 0,\n      stock: Number(item.json.stock) || 0\n    }\n  };\n});"
      },
